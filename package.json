  "scripts": {
    "start": "node --expose-gc --import tsx src/cli.ts pipeline --config config/amazon-uk.yaml",
    "asin-links": "node --expose-gc --import tsx src/asin-links-cli.ts",
    "pipeline": "node --expose-gc --import tsx src/cli.ts pipeline",
    "stores": "node --expose-gc --import tsx src/cli.ts stores",
    "source-resolution": "node --expose-gc --import tsx src/cli.ts source-resolution",
    "prefilter": "node --expose-gc --import tsx src/cli.ts prefilter",
    "history-filter": "node --expose-gc --import tsx src/cli.ts history-filter",
