    "export": "node --expose-gc --import tsx src/cli.ts export",
    "status": "node --expose-gc --import tsx src/cli.ts status",
    "proxy:check": "node --import tsx ..\\亚马逊爬取V2-TS+PY\\seller-sprite-poc\\src\\proxy-controller-cli.ts check --market uk --config ..\\亚马逊爬取V2-TS+PY\\seller-sprite-poc\\proxy-controller.yaml",
    "proxy:reconcile": "node --import tsx ..\\亚马逊爬取V2-TS+PY\\seller-sprite-poc\\src\\proxy-controller-cli.ts reconcile --market uk --reason manual --if-stale --config ..\\亚马逊爬取V2-TS+PY\\seller-sprite-poc\\proxy-controller.yaml",
    "check": "tsc --noEmit",
    "test": "vitest run tests/ts"
